<!-- ================= JAVASCRIPT ================= -->

<script>

/* ==========================================
   NAVEGAÇÃO
========================================== */

function abrir(nome){

    const telas =
        document.querySelectorAll(".tela");

    const botoes =
        document.querySelectorAll(".menu-btn");


    telas.forEach(tela => {

        tela.classList.remove("ativa");

    });


    const tela =
        document.getElementById(nome);

    if(tela){

        tela.classList.add("ativa");

    }


    botoes.forEach(botao => {

        botao.classList.remove("ativo");

        if(
            botao.dataset.tela === nome
        ){

            botao.classList.add("ativo");

        }

    });


    window.scrollTo({
        top:0,
        behavior:"smooth"
    });

}


/* ==========================================
   MENU
========================================== */

document
.querySelectorAll(".menu-btn")
.forEach(botao => {

    botao.addEventListener(
        "click",
        function(){

            abrir(this.dataset.tela);

        }
    );

});


/* ==========================================
   MODO ESCURO
========================================== */

const tema =
    document.getElementById("tema");

tema.addEventListener("click",function(){

    document.body.classList.toggle("escuro");


    if(
        document.body.classList.contains("escuro")
    ){

        tema.textContent="☀️";

        mostrarToast(
            "Modo escuro ativado"
        );

    }else{

        tema.textContent="🌙";

        mostrarToast(
            "Modo claro ativado"
        );

    }

});


/* ==========================================
   ATUALIZAR LIXEIRA
========================================== */

document
.getElementById("atualizar")
.addEventListener("click",function(){

    const botao=this;

    botao.style.transform=
        "rotate(360deg)";

    setTimeout(()=>{

        botao.style.transform=
            "rotate(0deg)";

    },500);


    for(let i=1;i<=4;i++){

        const valor =
            Math.floor(
                Math.random()*70
            )+20;


        document
        .getElementById("bar"+i)
        .style.width=
            valor+"%";


        document
        .getElementById("porc"+i)
        .textContent=
            valor+"% cheio";

    }


    mostrarToast(
        "Dados atualizados! ✓"
    );

});


/* ==========================================
   PESQUISA
========================================== */

const busca =
    document.getElementById("busca");


busca.addEventListener(
    "input",
    function(){

        const texto =
            this.value
            .toLowerCase()
            .trim();


        document
        .querySelectorAll(".material")
        .forEach(material=>{

            const nome =
                material
                .dataset
                .material
                .toLowerCase();


            if(
                nome.includes(texto)
            ){

                material.style.display=
                    "flex";

            }else{

                material.style.display=
                    "none";

            }

        });

    }
);


/* ==========================================
   CLICAR NOS MATERIAIS
========================================== */

document
.querySelectorAll(".material")
.forEach(material=>{

    material.addEventListener(
        "click",
        function(){

            const nome =
                this.querySelector("h3")
                .textContent;


            mostrarToast(
                nome+" selecionado ♻️"
            );

        }
    );

});


/* ==========================================
   NOTIFICAÇÕES
========================================== */

document
.getElementById("notificacoes")
.addEventListener(
    "change",
    function(){

        if(this.checked){

            mostrarToast(
                "Notificações ativadas 🔔"
            );

        }else{

            mostrarToast(
                "Notificações desativadas"
            );

        }

    }
);


/* ==========================================
   TOAST
========================================== */

function mostrarToast(texto){

    const toast =
        document.getElementById("toast");


    toast.textContent=texto;

    toast.classList.add("mostrar");


    clearTimeout(
        window.timerToast
    );


    window.timerToast =
        setTimeout(()=>{

            toast.classList.remove(
                "mostrar"
            );

        },2200);

}


/* ==========================================
   CLIQUE NOS CARTÕES
========================================== */

document
.querySelectorAll(".card-status")
.forEach(card=>{

    card.addEventListener(
        "click",
        function(){

            const nome =
                this.querySelector("h3")
                .textContent;


            mostrarToast(
                nome+
                ": consulte o nível acima."
            );

        }
    );

});


/* ==========================================
   INICIALIZAÇÃO
========================================== */

console.log(
    "EcoLixeira carregada com sucesso!"
);

</script>

